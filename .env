# ═══════════════════════════════════════════════════════════
# NOC ML Pipeline — Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file as .env and fill in your actual credentials.
# Never commit this file with real passwords to source control.

# ── MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=railtel

# ── Alarm table (real railtel schema)
ALARM_TABLE=ALARM
ALARM_NE_ID_COL=ENTITY_ID
ALARM_CODE_COL=ALARM_CODE
ALARM_SEVERITY_COL=SEVERITY
ALARM_TIMESTAMP_COL=OPEN_TIME
ALARM_ROOT_CAUSE_COL=PROBABLE_CAUSE
ALARM_STATUS_COL=ALARM_STATUS
ALARM_CLEAR_TIME_COL=CLOSURE_TIME

# ── Pipeline tuning
CHUNK_SIZE=50000
OUTPUT_DIR=data/processed
MODELS_DIR=data/models
DEPLOY_DIR=data/models/deploy
LOG_LEVEL=INFO

# ── ONNX export target (must match Spring Boot noc.models.deploy-dir)
# SPRING_DEPLOY_DIR=/models/deploy
